# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# --- Server only (mark as Sensitive in Vercel) ---

# Used only for the GHS 100 driver subscription. Start with the TEST secret key (sk_test_...). Switch to sk_live_... only after the go-live checklist in README.md.
PAYSTACK_SECRET_KEY=paste-your-paystack-secret-key-here

# Supabase service role key bypasses row level security: server only.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Encryption of traveller names, phone numbers, emails and addresses (lib/pii-crypto.js). Generate once:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep an offline copy in a password manager two directors can open. If these keys are lost, the encrypted data is lost.
PII_ENC_KEYS=v1:replace-with-32-random-bytes-base64
PII_INDEX_KEY=replace-with-32-random-bytes-base64

# --- Safe to expose to the browser (still keep out of Git) ---

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Settings ---

# Public address of the Woezor app (where Paystack sends drivers back after paying the subscription).
APP_URL=https://akwaaba.example.com


# Only for a staging site that is deployed as Vercel "production": allows the policy page to build with [●] placeholders.
# ALLOW_DRAFT_POLICY=1
